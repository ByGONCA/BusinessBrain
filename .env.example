# ==============================================================================
# KogSync - Enterprise Environment Configuration & Integration Manual
# Canonical Reference Template: .env.example
#
# IMPORTANT OPERATING RULES:
# 1. Copy this template to .env.local for local development:
#      cp .env.example .env.local
# 2. NEVER commit .env, .env.local, or actual cryptographic secrets to git.
# 3. Only variables prefixed with NEXT_PUBLIC_ are bundled to the browser client.
#    All other variables are STRICTLY SERVER-SIDE and must never be exposed.
# 4. Standardize multi-tenant credential isolation:
#    - Platform Credentials: Belong to KogSync itself (configured in this file).
#    - OAuth Application Credentials: Registered on provider developer consoles
#      identifying KogSync as the OAuth application (configured in this file).
#    - Customer-Specific Credentials: Connected account tokens (access/refresh),
#      workspace IDs, and API keys are stored per organization in PostgreSQL,
#      encrypted at rest with AES-256-GCM. NEVER add customer tokens here.
# ==============================================================================


# ==============================================================================
# 1. APPLICATION & RUNTIME CONFIGURATION
# ==============================================================================
# Purpose: Base URL and runtime flags governing URL generation, canonical links,
# metadata, CORS, redirect resolution, and API availability.

# Canonical base URL of the running application.
# Used by SSR link generators, OAuth state return URLs, sitemap, and metadataBase.
# Visibility: Public (client-side and server-side).
# Dev Value:  http://localhost:3000
# Prod Value: https://kogsync.com (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node.js runtime environment.
# Controls debug log verbosity, security checks, and strict secret enforcement.
# In "production" and "staging", weak secrets and placeholders trigger fatal startup errors.
# Visibility: Server-side only.
# Values: development | production | test
NODE_ENV=development


# ==============================================================================
# 2. SUPABASE CONFIGURATION
# ==============================================================================
# Purpose: Primary multi-tenant PostgreSQL database, Row Level Security (RLS),
# user authentication, session cookies, storage buckets, and real-time events.
#
# Authentication: Supabase SSR Cookie Session (@supabase/ssr) + PostgreSQL RLS.
#
# SETUP TUTORIAL:
# 1. Visit the Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your project (or create a new project).
# 3. Navigate to: Project Settings -> API.
# 4. Copy "Project URL" into NEXT_PUBLIC_SUPABASE_URL.
# 5. Copy "anon public" key (or new sb_publishable_... format) into NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# 6. Under "Project API keys", reveal and copy the "service_role" key into SUPABASE_SERVICE_ROLE_KEY.
# 7. Under "JWT Settings", copy the "JWT Secret" into SUPABASE_JWT_SECRET.
#
# USER AUTH OAUTH PROVIDERS (Supabase Built-in Auth):
# If you allow users to sign up / log in to KogSync with Google or GitHub:
# - Go to: Authentication -> Providers -> Google / GitHub.
# - Enter your Google/GitHub OAuth credentials in Supabase Dashboard.
# - Register this Callback URL in Google Cloud / GitHub OAuth App:
#     https://<your-project-id>.supabase.co/auth/v1/callback
# - NOTE: This is strictly for user authentication sessions. It is independent of
#   the KogSync Workspace Integrations (Sections 8, 9, 10, 11, 12 below).
# ==============================================================================

# Supabase Project HTTPS URL.
# Visibility: Public (safe for browser exposure).
# Mandatory in all environments.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (or sb_publishable_... token).
# Tied to PostgreSQL RLS "anon" role. Safe for client-side JavaScript.
# Visibility: Public (safe for browser exposure).
# Mandatory in all environments.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pk_test_placeholder_or_sb_publishable_placeholder

# Supabase Service Role Secret Key (Privileged Administrative Access).
# Bypasses Row Level Security. Used EXCLUSIVELY by server-side background tasks,
# Stripe billing webhook synchronization, and administrative PostgreSQL RPCs.
# Visibility: STRICTLY SERVER-SIDE. NEVER EXPOSE TO CLIENT BUNDLE OR BROWSER.
# Mandatory in all environments.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_secret

# Supabase JWT Secret.
# Used for verifying Supabase auth JWT signatures and HMAC ticket signing in guardrails.
# Visibility: STRICTLY SERVER-SIDE.
# Mandatory in production & staging.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars


# ==============================================================================
# 3. STRIPE PLATFORM BILLING (KOGSYNC SAAS SUBSCRIPTIONS)
# ==============================================================================
# Purpose: Governs customer subscription billing for KogSync itself (Starter,
# Pro, Enterprise tiers), checkout sessions, customer portal, and webhooks.
#
# SETUP TUTORIAL:
# 1. Visit the Stripe Dashboard: https://dashboard.stripe.com/
# 2. Switch between "Test Mode" (top right toggle) for dev and "Live Mode" for prod.
# 3. Navigate to: Developers -> API keys.
#    - Copy "Secret key" (sk_test_... or sk_live_...) into STRIPE_SECRET_KEY.
#    - Copy "Publishable key" (pk_test_... or pk_live_...) into NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
# 4. Navigate to: Product Catalog -> Add Products:
#    - Create 3 recurring monthly subscription products: Starter, Pro, Enterprise.
#    - Copy each recurring Price ID (price_...) into the corresponding variable below.
# 5. Navigate to: Developers -> Webhooks -> Add endpoint:
#    - Endpoint URL (Local Dev via Stripe CLI): http://localhost:3000/api/webhooks/stripe
#    - Endpoint URL (Production):              https://kogsync.com/api/webhooks/stripe
#    - Listen to events:
#        * checkout.session.completed
#        * customer.subscription.created
#        * customer.subscription.updated
#        * customer.subscription.deleted
#        * invoice.payment_succeeded
#        * invoice.payment_failed
# 6. Copy the endpoint's "Signing secret" (whsec_...) into STRIPE_WEBHOOK_SECRET.
#
# LOCAL WEBHOOK TESTING VIA STRIPE CLI:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# ==============================================================================

# Stripe Secret API Key.
# Visibility: STRICTLY SERVER-SIDE. NEVER EXPOSE TO CLIENT BUNDLE.
# Mandatory in production & staging.
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key

# Stripe Publishable Key.
# Visibility: Public (client-side checkout initialization).
# Mandatory in production & staging.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key

# Stripe Webhook Endpoint Secret (whsec_...).
# Used by stripe.webhooks.constructEvent to cryptographically verify payload signatures.
# Visibility: STRICTLY SERVER-SIDE.
# Mandatory for webhook verification.
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# Internal Product Tier Price IDs (Server-Side Resolution):
STRIPE_STARTER_PRICE_ID=price_starter_monthly_placeholder
STRIPE_PRO_PRICE_ID=price_pro_monthly_placeholder
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly_placeholder


# ==============================================================================
# 4. STRIPE CONNECT (TENANT FINANCIAL ANALYTICS & E-COMMERCE METRICS)
# ==============================================================================
# Purpose: Allows KogSync customer organizations to link their OWN Stripe accounts
# to view real-time MRR, ARR, churn, and revenue analytics inside KogSync Dashboards.
#
# SETUP TUTORIAL:
# 1. Visit: https://dashboard.stripe.com/settings/connect
# 2. Go to: Integration settings -> OAuth settings.
# 3. Enable "OAuth for Standard accounts".
# 4. Copy the "Test client ID" (ca_test_...) or "Live client ID" (ca_live_...).
# 5. Add Authorized Redirect URIs in Stripe Dashboard:
#    - Local Development: http://localhost:3000/api/integrations/stripe/callback
#    - Production:        https://kogsync.com/api/integrations/stripe/callback
# 6. Least-Privilege Scope: Strictly "read_only" (enforced automatically in code).
# ==============================================================================

# Stripe Connect OAuth Client ID (ca_test_... or ca_live_...).
# Visibility: STRICTLY SERVER-SIDE.
# Mandatory if customer Stripe Connect analytics integration is enabled.
STRIPE_CONNECT_CLIENT_ID=ca_test_placeholder_connect_client_id


# ==============================================================================
# 5. AI PLATFORM PROVIDERS & MODEL REGISTRY
# ==============================================================================
# Purpose: Powers the KogSync Intelligence Engine, organizational memory synthesis,
# document summarization, executive insights, and multi-model chat.
#
# ARCHITECTURAL MODEL:
# KogSync supports two complementary AI models:
# 1. Platform-Managed AI: Global keys configured below serve baseline platform intelligence.
# 2. Customer BYOK (Bring Your Own Key): Enterprise customers can provide their own
#    encrypted API keys per organization in public.organization_ai_credentials.
# ==============================================================================

# Google Gemini API Key.
# Get your key at: https://aistudio.google.com/app/apikey
# Visibility: STRICTLY SERVER-SIDE.
GEMINI_API_KEY=AIzaSyPlaceholderGeminiKey

# OpenAI API Key.
# Get your key at: https://platform.openai.com/api-keys
# Visibility: STRICTLY SERVER-SIDE.
OPENAI_API_KEY=sk-placeholderOpenAiKey

# Anthropic Claude API Key.
# Get your key at: https://console.anthropic.com/settings/keys
# Visibility: STRICTLY SERVER-SIDE.
ANTHROPIC_API_KEY=sk-ant-placeholderAnthropicKey

# Groq High-Speed Inference API Key (Optional).
# Get your key at: https://console.groq.com/keys
# Visibility: STRICTLY SERVER-SIDE.
GROQ_API_KEY=gsk_placeholderGroqKey

# DeepSeek API Key (Optional).
# Get your key at: https://platform.deepseek.com/api_keys
# Visibility: STRICTLY SERVER-SIDE.
DEEPSEEK_API_KEY=sk-placeholderDeepSeekKey


# ==============================================================================
# 6. SECURITY & ENCRYPTION
# ==============================================================================
# Purpose: High-entropy cryptographic secrets protecting multi-tenant boundaries,
# encrypting customer OAuth tokens at rest, securing PostgreSQL rate limit counters,
# and authenticating server-to-database transactions.
#
# GENERATION COMMAND:
# Generate safe 32-byte (256-bit) hexadecimal strings using Node.js crypto:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# DATABASE STORAGE & ACCESS CONTROL VERIFICATION:
# In production, SERVER_AUTH_SECRET and INTERNAL_RATE_LIMIT_SECRET must match the
# secrets configured in PostgreSQL.
#
# Storage & Access Model:
# - Table: public.internal_system_secrets (columns: key, secret, created_at, updated_at).
# - Protection: Row Level Security is ENABLED. Permissions are strictly REVOKED from
#   'anon', 'authenticated', and 'public'. Only 'service_role' and 'postgres' roles
#   have access. Verified by Migration 00034 and automated security test suites.
# - Exposure Risk: ZERO client exposure. The table cannot be queried by browser clients,
#   untrusted tenants, or standard authenticated users.
# - Usage: Internal PostgreSQL SECURITY DEFINER functions (public.check_rate_limit and
#   public.verify_server_token) read these keys to perform RFC 2104 HMAC-SHA-256
#   calculations directly inside the database.
# ==============================================================================

# High-entropy secret for server-to-database HMAC-SHA-256 authentication tokens.
# Used for cryptographically signing invitation tokens, workspace transitions,
# and Stripe Connect state parameters.
# Length: Exactly 32 bytes (64 hex characters) or at least 32 characters.
# Visibility: STRICTLY SERVER-SIDE.
# Mandatory in production & staging.
SERVER_AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Dedicated high-entropy secret for PostgreSQL distributed rate limit token signing.
# Prevents clients or malicious tenants from spoofing rate limit tokens.
# Visibility: STRICTLY SERVER-SIDE.
# Mandatory in production & staging.
INTERNAL_RATE_LIMIT_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# 32-byte hexadecimal key for AES-256-GCM token encryption at rest.
# Encrypts customer OAuth access tokens, refresh tokens, and integration secrets
# stored in public.organization_integrations.
# Format: Exactly 64 hex characters (32 bytes).
# Visibility: STRICTLY SERVER-SIDE. NEVER EXPOSE TO CLIENT BUNDLE.
# Mandatory in production & staging. Fail-closed: zero fallback to Stripe keys.
INTEGRATION_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional previous encryption key for zero-downtime key rotation.
# When rotating INTEGRATION_TOKEN_ENCRYPTION_KEY, place the retiring key here.
# Decryption will attempt the primary key first, then gracefully fall back to this key.
# Visibility: STRICTLY SERVER-SIDE. Optional.
# INTEGRATION_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Dedicated 32-byte hexadecimal key for AES-256-GCM encryption of customer BYOK AI keys.
# Optional: If omitted, falls back to INTEGRATION_TOKEN_ENCRYPTION_KEY.
# Visibility: STRICTLY SERVER-SIDE.
# Format: Exactly 64 hex characters (32 bytes).
AI_CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional previous key for zero-downtime rotation of BYOK AI credentials.
# Visibility: STRICTLY SERVER-SIDE. Optional.
# AI_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=


# ==============================================================================
# 7. OAUTH STATE SIGNING (CANONICAL STATE HMAC-SHA256)
# ==============================================================================
# Purpose: Dedicated cryptographic secret used exclusively for signing and
# verifying OAuth state parameters across ALL third-party integration providers:
# - Linear (Sprint 2)
# - GitHub
# - Google Workspace
# - Microsoft 365
# - Slack
# - Stripe Connect
#
# SECURITY ARCHITECTURE:
# - Implementation: lib/security/oauth-state.ts (canonical helper)
# - Cryptographic Invariant: Zero fallback to STRIPE_SECRET_KEY, INTEGRATION_TOKEN_ENCRYPTION_KEY,
#   or AI_CREDENTIALS_ENCRYPTION_KEY. Cross-domain secret sharing is strictly prohibited.
# - Verification: Constant-time comparison via crypto.timingSafeEqual.
# - Replay Protection: Single-use state nonce bound to organization ID and timestamp.
# - Generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# Dedicated OAuth State Signing Secret.
# Length: At least 32 characters (256-bit entropy recommended).
# Visibility: STRICTLY SERVER-SIDE.
# Mandatory in production & staging (fail-closed: startup fails if omitted in production).
OAUTH_STATE_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


# ==============================================================================
# 8. GOOGLE INTEGRATIONS (GMAIL & GOOGLE CALENDAR)
# ==============================================================================
# Purpose: Allows KogSync organizations to connect their Google Workspace or Gmail
# to analyze communication patterns, index company calendar events, and draft emails.
#
# SETUP TUTORIAL:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/
# 2. Select or create a project (e.g., "KogSync Production").
# 3. Enable Required APIs:
#    - Google Calendar API
#    - Gmail API
# 4. Configure OAuth Consent Screen:
#    - User Type: External (for public multi-tenant SaaS) or Internal.
#    - Scopes:
#        * openid
#        * .../auth/userinfo.email
#        * .../auth/userinfo.profile
#        * .../auth/gmail.readonly
#        * .../auth/gmail.send
#        * .../auth/gmail.compose
#        * .../auth/calendar.events
#        * .../auth/calendar.readonly
# 5. Create OAuth 2.0 Client ID:
#    - Application type: Web application.
#    - Authorized JavaScript origins:
#        * http://localhost:3000 (Local Dev)
#        * https://kogsync.com (Production)
#    - Authorized redirect URIs:
#        * http://localhost:3000/api/integrations/google/callback (Local Dev)
#        * https://kogsync.com/api/integrations/google/callback (Production)
# 6. Click "Create" and copy Client ID and Client Secret into the variables below.
# ==============================================================================

# Google OAuth 2.0 Client ID.
# Visibility: Server-side only (passed in backend authorization redirect).
GOOGLE_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret.
# Visibility: STRICTLY SERVER-SIDE.
GOOGLE_CLIENT_SECRET=GOCSPX-placeholderGoogleClientSecret


# ==============================================================================
# 9. MICROSOFT 365 INTEGRATIONS (OUTLOOK MAIL & OUTLOOK CALENDAR)
# ==============================================================================
# Purpose: Connects Microsoft 365 / Entra ID tenant email and calendars to KogSync.
#
# SETUP TUTORIAL:
# 1. Visit Microsoft Entra Admin Center: https://entra.microsoft.com/
# 2. Navigate to: Identity -> Applications -> App registrations -> "+ New registration".
# 3. Configure the Application:
#    - Name: KogSync
#    - Supported account types: "Accounts in any organizational directory (Any Microsoft Entra ID tenant - Multitenant) and personal Microsoft accounts".
#    - Redirect URI (Web):
#        * Local Dev:   http://localhost:3000/api/integrations/microsoft/callback
#        * Production:  https://kogsync.com/api/integrations/microsoft/callback
# 4. Click "Register".
# 5. Copy the "Application (client) ID" into MICROSOFT_CLIENT_ID.
# 6. Generate Client Secret:
#    - Certificates & secrets -> "+ New client secret" -> Description: "KogSync Production".
#    - Copy "Value" immediately into MICROSOFT_CLIENT_SECRET.
# 7. Configure Delegated Graph API Permissions:
#    - API permissions -> "+ Add a permission" -> Microsoft Graph -> Delegated permissions:
#        * openid, profile, email, offline_access
#        * Mail.Read, Mail.Send
#        * Calendars.ReadWrite
# ==============================================================================

# Microsoft Entra ID Application (Client) ID.
# Visibility: Server-side only.
MICROSOFT_CLIENT_ID=placeholder-microsoft-client-id-uuid

# Microsoft Entra ID Client Secret.
# Visibility: STRICTLY SERVER-SIDE.
MICROSOFT_CLIENT_SECRET=placeholder-microsoft-client-secret-value


# ==============================================================================
# 10. GITHUB INTEGRATION
# ==============================================================================
# Purpose: Ingests repositories, issues, pull requests, releases, and development
# activity to synthesize engineering velocity and codebase knowledge graphs.
#
# SETUP TUTORIAL:
# 1. Visit GitHub Developer Settings: https://github.com/settings/developers
# 2. Select: OAuth Apps -> "New OAuth App" (or GitHub Apps -> "New GitHub App").
# 3. Configure the Application:
#    - Application name: KogSync
#    - Homepage URL: https://kogsync.com
#    - Authorization callback URL:
#        * Local Dev:  http://localhost:3000/api/integrations/github/callback
#        * Production: https://kogsync.com/api/integrations/github/callback
# 4. Click "Register application".
# 5. Copy "Client ID" into GITHUB_CLIENT_ID.
# 6. Click "Generate a new client secret" and copy into GITHUB_CLIENT_SECRET.
# 7. Webhook Configuration (For real-time repository updates):
#    - Payload URL: https://kogsync.com/api/integrations/github/webhook
#    - Content type: application/json
#    - Secret: Generate a 32-byte secret and copy into GITHUB_WEBHOOK_SECRET.
#    - Events: Issues, Pull requests, Push, Releases.
# 8. Required OAuth Scopes (requested automatically during authorization):
#    - repo, read:user, user:email, read:org
# ==============================================================================

# GitHub OAuth Client ID.
# Visibility: Server-side only.
GITHUB_CLIENT_ID=placeholder_github_client_id

# GitHub OAuth Client Secret.
# Visibility: STRICTLY SERVER-SIDE.
GITHUB_CLIENT_SECRET=placeholder_github_client_secret

# GitHub Webhook HMAC Secret.
# Used to verify X-Hub-Signature-256 header.
# Visibility: STRICTLY SERVER-SIDE.
GITHUB_WEBHOOK_SECRET=placeholder_github_webhook_secret


