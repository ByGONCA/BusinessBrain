 # ==============================================================================
# Company Brain - Environment Variables Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain from Supabase Project Settings -> API
# ------------------------------------------------------------------------------
# Public project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pk_test_... or sb_publishable_...

# Note on OAuth Providers:
# Google and GitHub OAuth credentials for user auth are configured in Supabase Dashboard:
# Authentication -> Providers -> Google / GitHub
# Callback URL to register in Google Cloud / GitHub OAuth App:
# https://<your-project-id>.supabase.co/auth/v1/callback

# ------------------------------------------------------------------------------
# Stripe Billing & Trial Configuration
# Obtain from Stripe Dashboard -> Developers -> API keys & Webhooks
# ------------------------------------------------------------------------------
# Publishable key (safe for browser exposure)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret (SERVER-SIDE ONLY - Used to verify stripe webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Configurable Free Trial Duration in Days (Defaults to 7 if omitted)
TRIAL_DAYS=7

# Stripe Recurring Price IDs (Monthly)
# Create in Stripe Dashboard -> Product catalog (Recurring / Monthly)
STRIPE_STARTER_PRICE_ID=price_starter_test_123
STRIPE_PRO_PRICE_ID=price_pro_test_456
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_test_789

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Prepared for future AI layer)
# Obtain from Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
# Gemini API Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# Security & Token Encryption (For Integration Tokens at Rest)
# ------------------------------------------------------------------------------
# 32-byte hexadecimal string for AES-256-GCM token encryption at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# INTEGRATION PROVIDERS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Integrations (Gmail & Google Calendar - Individually Configurable)
# Obtain from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
# Authorized redirect URI: http://localhost:3000/api/integrations/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ------------------------------------------------------------------------------
# 2. Microsoft 365 Integrations (Outlook Mail & Outlook Calendar)
# Obtain from Azure Portal (Microsoft Entra ID -> App registrations)
# Authorized redirect URI: http://localhost:3000/api/integrations/microsoft/callback
# ------------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your-microsoft-client-id-uuid
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-value
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback

# ------------------------------------------------------------------------------
# 3. GitHub Integration (Repositories, Issues, Pull Requests & Releases)
# Obtain from GitHub Settings -> Developer settings -> OAuth Apps or GitHub Apps
# Authorized callback URL: http://localhost:3000/api/integrations/github/callback
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/integrations/github/callback
# Optional GitHub App Slug (used to generate direct installation links)
GITHUB_APP_SLUG=your-github-app-slug

# ------------------------------------------------------------------------------
# 4. Stripe Integration (Revenue, Subscriptions & Invoices Ingestion)
# Uses STRIPE_SECRET_KEY above, plus optional Restricted Key for analytics:
# ------------------------------------------------------------------------------
STRIPE_RESTRICTED_KEY=rk_test_...

# ------------------------------------------------------------------------------
# 5. Shopify Integration (E-Commerce Orders, Customers & Products)
# Obtain from Shopify Partner Dashboard -> Apps -> Configuration
# Authorized redirect URL: http://localhost:3000/api/integrations/shopify/callback
# ------------------------------------------------------------------------------
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_SCOPES=read_orders,read_products,read_customers
SHOPIFY_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Vercel Integration (Deployments, Project Builds & Status Alerts)
# Obtain from Vercel Dashboard -> Account Settings -> Tokens
# ------------------------------------------------------------------------------
VERCEL_TOKEN=your-vercel-personal-or-team-access-token
VERCEL_TEAM_ID=team_...
VERCEL_PROJECT_ID=prj_...

# ------------------------------------------------------------------------------
# 7. Sentry Integration (Error Tracking, Exceptions & Performance Insights)
# Obtain from Sentry Organization Settings -> Developer Settings -> Internal Integrations
# ------------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG_SLUG=your-sentry-org-slug
SENTRY_PROJECT_SLUG=your-sentry-project-slug
SENTRY_WEBHOOK_SECRET=your-sentry-webhook-secret

# ------------------------------------------------------------------------------
# 8. Linear Integration (Issue Tracking, Cycles & Roadmaps)
# Obtain from Linear Settings -> Workspace -> API -> Applications or Personal API Keys
# Authorized redirect URI: http://localhost:3000/api/integrations/linear/callback
# ------------------------------------------------------------------------------
LINEAR_API_KEY=lin_api_...
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret
LINEAR_REDIRECT_URI=http://localhost:3000/api/integrations/linear/callback
