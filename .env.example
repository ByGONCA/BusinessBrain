# ==============================================================================
# 14. VERCEL INTEGRATION (STATUS: CONFIGURATION PENDING / NOT YET IMPLEMENTED)
# ==============================================================================
# Purpose: Ingest deployment logs, preview statuses, build health, and runtime alerts.
#
# STATUS: CONFIGURATION PENDING.
# Listed in the integration catalog, but customer-facing OAuth flow is pending.
#
# ARCHITECTURAL INVARIANT:
# KogSync is a multi-tenant platform. Global variables such as VERCEL_TOKEN,
# VERCEL_TEAM_ID, or VERCEL_PROJECT_ID represent a single personal/internal account
# and cannot be used for multi-tenant customer workspaces.
#
# MULTI-TENANT SOLUTION:
# Customer workspaces will authorize via Vercel Integrations Console (OAuth 2.0).
# Official URL: https://vercel.com/dashboard/integrations/console
# When implemented, each customer organization will grant access to their own
# Vercel team/projects, and tokens will be stored encrypted in the database.
#
# (No global Vercel tokens are required or used for customer integrations).
# ==============================================================================


# ==============================================================================
# 15. SENTRY ERROR TRACKING & PERFORMANCE OBSERVABILITY (PLATFORM MONITORING)
# ==============================================================================
# Purpose: Real-time application error monitoring, exception reporting, and
# performance observability across Client, Node.js Server, and Edge runtimes.
#
# SETUP TUTORIAL (FREE DEVELOPER TIER):
# 1. Visit: https://sentry.io/ and log in or create a free Developer account.
# 2. Create a new Project: Select "Next.js" -> Name it "kogsync".
# 3. Copy the Client Keys (DSN) from: Project Settings -> Client Keys (DSN).
# 4. Paste the DSN into NEXT_PUBLIC_SENTRY_DSN.
# 5. (Optional) Create an Internal Integration / Auth Token for Source Map Uploads:
#    - Navigate to: User Settings -> API -> Auth Tokens (or Org Settings -> Developer Settings -> Internal Integrations).
#    - Create token with scopes: "project:read", "project:releases", "org:read".
#    - Copy into SENTRY_AUTH_TOKEN.
#    - Set SENTRY_ORG (organization slug) and SENTRY_PROJECT (project slug).
#
# PRIVACY & SECURITY INVARIANTS:
# - All sensitive keys (passwords, tokens, cookies, authorization headers, stripe signatures)
#   are automatically scrubbed via lib/security/sentry-filter.ts before transmission.
# - Webhook payloads (/api/webhooks/*) and auth bodies (/api/auth/*) are completely redacted.
# - sendDefaultPii is disabled; user email and IP addresses are never transmitted.
# ==============================================================================

# Sentry Public Data Source Name (DSN).
# Used by both client browser bundle and server runtime to deliver error envelopes.
# Visibility: Public (safe for client bundle).
# Optional in development; mandatory in production for live telemetry.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Server-Side DSN (Optional fallback if distinct from public DSN).
# Visibility: STRICTLY SERVER-SIDE.
SENTRY_DSN=

# Sentry Authentication Token (For automated source map uploading at build-time).
# Visibility: STRICTLY SERVER-SIDE / CI ONLY. NEVER EXPOSE TO CLIENT BUNDLE.
SENTRY_AUTH_TOKEN=

# Sentry Organization Slug (e.g., 'kogsync-org').
# Visibility: Server-side build configuration.
SENTRY_ORG=

# Sentry Project Slug (e.g., 'kogsync').
# Visibility: Server-side build configuration.
SENTRY_PROJECT=


# ==============================================================================
# 16. TRANSACTIONAL EMAIL & NOTIFICATIONS (RESEND)
# ==============================================================================
# Purpose: Delivers team invitation emails, workspace member notifications,
# security alerts, and action approval ticket notifications.
#
# SETUP TUTORIAL:
# 1. Visit: https://resend.com/
# 2. Sign up or log in -> Navigate to: API Keys (https://resend.com/api-keys).
# 3. Click "Create API Key" -> Name: "KogSync Transactional" -> Permission: "Sending access".
# 4. Copy the API key starting with "re_..." into RESEND_API_KEY.
# 5. Navigate to: Domains (https://resend.com/domains) -> Add your domain (e.g. kogsync.com).
# 6. In development, you can use Resend's free test sender: onboarding@resend.dev.
# ==============================================================================

# Resend API Key.
# Visibility: STRICTLY SERVER-SIDE. NEVER EXPOSE TO CLIENT BUNDLE.
# Mandatory in production for sending emails.
RESEND_API_KEY=re_placeholder_resend_api_key

# Verified Sender Email Address.
# In production, must use your verified domain (e.g. notifications@kogsync.com).
# In development, use "KogSync <onboarding@resend.dev>".
# Visibility: Server-side only.
EMAIL_FROM=KogSync <onboarding@resend.dev>


# ==============================================================================
# 17. MAINTENANCE & CRON CONFIGURATION
# ==============================================================================
# Purpose: Protects automated maintenance endpoints and scheduled jobs (such as
# cleaning abandoned file uploads, pruning expired tokens, and refreshing metrics).
#
# ENDPOINTS:
# - POST /api/maintenance/cleanup: Prunes abandoned temporary file uploads (> 2 hours).
#   Requires header: Authorization: Bearer <CRON_SECRET> or <INTERNAL_MAINTENANCE_SECRET>.
# ==============================================================================

# Scheduled Maintenance & Vercel Cron Secret.
# Authenticates automated maintenance endpoints via Bearer token.
# Visibility: STRICTLY SERVER-SIDE.
# Mandatory in production if scheduled cleanup cron jobs are configured.
CRON_SECRET=your-high-entropy-cron-secret-32-chars-minimum

# Internal Operations Maintenance Secret (Alternative / Fallback for operational CLI).
# Visibility: STRICTLY SERVER-SIDE.
INTERNAL_MAINTENANCE_SECRET=your-internal-ops-secret-32-chars-minimum


# ==============================================================================
# 18. DATABASE SCRIPTS & LOCAL TESTING
# ==============================================================================
# Purpose: Direct PostgreSQL connection for administrative CLI migration scripts,
# local seeding, and deterministic test suites.
#
# LOCAL TESTING ARCHITECTURE:
# - PGlite (@electric-sql/pglite): KogSync runs a full WASM PostgreSQL 16 engine
#   in-memory for 100% deterministic local test suites without requiring a running Docker
#   or cloud Supabase instance.
# - Direct Connection (Optional for CLI scripts):
#   Use Supabase Transaction Pooler (port 6543) or Session Pooler (port 5432).
# ==============================================================================

# Direct PostgreSQL Connection URL (Used by CLI scripts, not web runtime).
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Visibility: STRICTLY SERVER-SIDE. Optional.
# DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres


# ==============================================================================
# 19. FEATURE FLAGS & OPTIONAL CONFIGURATION
# ==============================================================================
# Purpose: Runtime toggles governing experimental features and external integrations.

# Enterprise Public API Feature Flag (/api/v1).
# Strictly disabled (false) by default in all environments for security perimeter.
# When false, all /api/v1 routes return immediate HTTP 404 without executing logic.
# Visibility: Server-side only.
# Values: false (default) | true
FEATURE_FLAG_PUBLIC_API_ENABLED=false

# Workspace Content Importers (Notion & Confluence):
# Importers (lib/integrations/importers/notion.ts, confluence.ts) run on-demand via
# user-supplied credentials in the import dialog. In accordance with multi-tenant
# security invariants, NO global credentials are used or configured in this file.
# ==============================================================================
